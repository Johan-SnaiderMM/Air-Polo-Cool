# Copia este archivo a .env.local y completa los valores.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_. Se usa únicamente para firmar
# las URLs de las fotos del portal público /orden/[token] (bucket privado).
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública de la app (para los enlaces /orden/[token] en WhatsApp) ---
# En producción: https://tu-dominio.com  (sin barra final).
# Si se omite, se deduce del host de la petición.
NEXT_PUBLIC_SITE_URL=

# --- Envío automático de WhatsApp (opcional) ---
# Proveedor: "evolution" (Evolution API) o "waha" (WAHA).
WHATSAPP_PROVIDER=evolution
# Evolution: https://tu-servidor-evolution   |  WAHA: https://tu-servidor-waha
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
# Evolution: nombre de la instancia  |  WAHA: nombre de la sesión (ej. "default")
WHATSAPP_INSTANCE=
# "true" para enviar solo al cambiar el estado a Listo/Entregado. Apagado por defecto.
WHATSAPP_AUTO_ENVIO=false
